# PostgreSQL runtime connection (pooled URL recommended on Vercel)
DATABASE_URL="postgresql://rehema:change-me@localhost:5432/rehema_universe"

# Direct connection used by Prisma migrations when the provider exposes one
DIRECT_URL="postgresql://rehema:change-me@localhost:5432/rehema_universe"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Used only by prisma/seed.ts to create the initial administrator
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-before-seeding"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Daily portfolio agent hosted by Vercel (random value, at least 16 characters)
CRON_SECRET=""

# Optional: raises the GitHub API rate limit for repository synchronization
GITHUB_TOKEN=""

# Optional: official LinkedIn API access with w_member_social permission
LINKEDIN_ACCESS_TOKEN=""
LINKEDIN_AUTHOR_URN="urn:li:person:replace-me"
LINKEDIN_API_VERSION="202609"
